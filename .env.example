# Environment variables for the application
# Copy this to .env and fill in your values

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Feature Flags
VITE_QUOTED_SEGMENTATION=0  # Set to 1 to enable quoted email segmentation (disabled by default)

# Dev utilities - set to 1 to enable UI debugging probes
VITE_UI_PROBE=0
# Dev-only one-click sign-in (local / Lovable preview ONLY — never set in prod builds).
# Create a dedicated admin test user in Supabase Auth (Users -> Add user, auto-confirm),
# then put its credentials here in your local .env to get a REAL Supabase session
# (real JWT, real RLS scope) from the "Dev sign-in" button on /auth.
VITE_DEV_LOGIN_EMAIL=""
VITE_DEV_LOGIN_PASSWORD=""

# Observability (browser-safe, non-secret)
VITE_APP_OPENPANEL_CLIENT_ID="c2dd01f1-8961-4932-8d53-f836f7d1da56"
VITE_APP_OPENPANEL_API_URL="https://analytics.noddi.co/api"
# VITE_APP_OPENPANEL_STUB=1

# Grafana Faro RUM → Alloy faro.receiver via first-party host (auth proxy = ztrapi x-api-key).
# URL default in code: https://telemetry.noddi.co
# API key from GSM (noddi-prod):
#   gcloud secrets versions access latest --secret=alloy_faro_app_key --project=noddi-prod
VITE_APP_FARO_URL=https://telemetry.noddi.co
VITE_APP_FARO_API_KEY=

# Sentry (browser DSN is public; leave empty to disable)
VITE_SENTRY_DSN="https://dc957f9ac5734901df820e05d57431ca@o4506178120646656.ingest.us.sentry.io/4512020718944256"

# Source map upload for production builds — prefer `.env.sentry-build-plugin`
# (auto-read by @sentry/vite-plugin; gitignored). Or set these in CI:
# SENTRY_ORG=noddi
# SENTRY_PROJECT=support-hub
# SENTRY_AUTH_TOKEN=sntrys_...
