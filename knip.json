{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/instrument.ts",
    "src/widget/index.tsx",
    "scripts/**/*.{ts,tsx,js,mjs,cjs}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx}"],
  "ignore": ["src/dev/**", "**/*.stories.tsx", "src/components/ui/**"],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "@tailwindcss/postcss",
    "tailwindcss-animate",
    "autoprefixer",
    "postcss",
    "lovable-tagger",
    "@lovable.dev/vite-plugin-dev-server-bridge",
    "@lovable.dev/vite-plugin-hmr-gate",
    "@storybook/react",
    "@vitest/coverage-v8",
    "@playwright/test",
    "@swc/core",
    "esbuild",
    "rollup",
    "@eslint/js",
    "@secretlint/secretlint-rule-preset-recommend",
    "@tanstack/react-router-devtools",
    "@tanstack/react-query-devtools",
    "@testing-library/user-event",
    "@types/dompurify",
    "@types/lodash.throttle",
    "@types/react-virtualized-auto-sizer",
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "embla-carousel-react",
    "input-otp",
    "lodash.throttle",
    "picocolors",
    "react-icons",
    "vaul",
    "secretlint",
    "knip",
    "dependency-cruiser",
    "lint-staged",
    "jscpd",
    "eslint-plugin-import-x",
    "eslint-import-resolver-typescript",
    "@eslint-react/eslint-plugin",
    "eslint-plugin-testing-library",
    "eslint-plugin-vitest",
    "eslint-plugin-storybook",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "typescript-eslint",
    "globals",
    "husky",
    "prettier",
    "@biomejs/biome",
    "@emoji-mart/react",
    "@radix-ui/react-accordion",
    "@radix-ui/react-aspect-ratio",
    "@radix-ui/react-hover-card",
    "@radix-ui/react-menubar",
    "@radix-ui/react-navigation-menu",
    "@radix-ui/react-toggle",
    "@radix-ui/react-toggle-group"
  ],
  "ignoreBinaries": ["supabase", "gitleaks", "semgrep", "osv-scanner"],
  "playwright": false,
  "vite": {
    "config": ["vite.config.ts", "vite.widget.config.ts"]
  },
  "vitest": {
    "config": ["vitest.config.ts"]
  }
}
