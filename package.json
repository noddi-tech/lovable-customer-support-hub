{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "bun run lint:all && bun run lint:knip && bun run lint:deps && bun run lint:secrets && bun run lint:dupes && bun run lint:semgrep && bun run lint:audit",
    "lint:core": "biome check --error-on-warnings . && eslint . --max-warnings=0",
    "lint:biome": "biome check --error-on-warnings .",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:tabs": "tsx scripts/lint-tabs-overflow.ts",
    "lint:pane": "tsx scripts/lint-pane-scroll.ts",
    "lint:all": "bun run lint:core && bun run lint:tabs && bun run lint:pane",
    "format": "biome check --write --formatter-enabled=true --linter-enabled=false --assist-enabled=true . && prettier --write \"**/*.{md,mdx}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx}\"",
    "format:md": "prettier --write \"**/*.{md,mdx}\"",
    "format:md:check": "prettier --check \"**/*.{md,mdx}\"",
    "fix": "biome check --write . && eslint . --fix --max-warnings=0 && prettier --write \"**/*.{md,mdx}\"",
    "fix:unsafe": "biome check --write --unsafe . && eslint . --fix --max-warnings=0 && prettier --write \"**/*.{md,mdx}\"",
    "check": "bun run lint:all && bun run format:check && bun run typecheck && bun run test && bun run ui:guards",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:tabs": "vitest --run --reporter=verbose src/components/ui/__tests__/tabs-long-labels.test.tsx",
    "docs:api": "tsx scripts/generate-openapi.ts",
    "preview": "vite preview",
    "ui:guards": "tsx scripts/lint-tabs-overflow.ts && vitest --run --reporter=verbose src/components/ui/__tests__/tabs-long-labels.test.tsx",
    "quality:gate": "sh scripts/quality-gate.sh --fix-and-check",
    "quality:gate:check": "sh scripts/quality-gate.sh --check-only",
    "precommit": "bunx lint-staged && sh scripts/quality-gate.sh --check-only",
    "prepush": "sh scripts/quality-gate.sh --fix-and-check",
    "prepare": "husky",
    "prepublish:check": "bun run ui:guards && bun run build",
    "lint:eslint:typed": "ESLINT_TYPED_STRICT=1 eslint .",
    "lint:knip": "knip --include dependencies,unlisted,binaries,unresolved --no-config-hints",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs -T err src",
    "lint:secrets": "sh scripts/lint-secrets.sh",
    "lint:dupes": "jscpd src scripts --config .jscpd.json",
    "lint:semgrep": "sh scripts/lint-semgrep.sh",
    "lint:audit": "bun audit --audit-level=critical",
    "lint:strict": "bun run lint",
    "ci": "bun run quality:gate:check && bun run typecheck && bun run test && bun run lint:strict"
  },
