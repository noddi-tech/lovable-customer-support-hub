# Registry configuration for internal @navio scoped packages.
# These are published to Google Artifact Registry (public read access).
@navio:registry=https://europe-north1-npm.pkg.dev/noddi-prod/npm-public-en1/

# react-day-picker@8 declares a peer of date-fns ^2||^3 but works with date-fns 4.
# Allow npm (incl. `npm ci` in CI) to resolve this known-safe conflict.
legacy-peer-deps=true
